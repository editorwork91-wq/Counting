# Copy to local.properties (DO NOT COMMIT local.properties)
# These are runtime/public-client settings only.

YOMY_ENVIRONMENT=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional remote push provider. Leave empty until configured.
PUSH_PROVIDER=
PUSH_APP_ID=

# NEVER place these in this file or the APK:
# SUPABASE_SERVICE_ROLE_KEY
# VONAGE_API_SECRET
# VONAGE_PRIVATE_KEY
# ONESIGNAL_REST_API_KEY
# FIREBASE_SERVICE_ACCOUNT_JSON
# ANDROID_KEYSTORE_PASSWORD
